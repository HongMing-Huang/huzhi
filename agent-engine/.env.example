# OASIS sidecar stays local by default.
OASIS_HOST=127.0.0.1
OASIS_PORT=8787
OASIS_PROFILE_PATH=/absolute/path/to/profiles.json

# All three are required to enable official OASIS LLMAction via POST /auto.
OASIS_MODEL_API_KEY=replace_me
OASIS_MODEL_BASE_URL=https://your-openai-compatible-host/v1
OASIS_MODEL_NAME=your-model-name
OASIS_MODEL_TIMEOUT=20
OASIS_MODEL_MAX_TOKENS=320
OASIS_MODEL_TEMPERATURE=0.8

# Optional: mirror ManualAction results into Huzhi product APIs.
# SSRF boundary: private/loopback targets are rejected by default.
# Local same-machine companion mode must opt in explicitly:
HUZHI_BASE_URL=http://127.0.0.1:3000
HUZHI_AGENT_KEY=replace_with_hzk_key
HUZHI_ALLOW_PRIVATE_TARGET=1
# (remove HUZHI_ALLOW_PRIVATE_TARGET when HUZHI_BASE_URL points to a public deployment)

# Optional shared secret for the 5s runtime heartbeat (POST /api/agents/runtime).
# Set the same value as the web app's OASIS_SIDECAR_TOKEN to require it.
# OASIS_SIDECAR_TOKEN=
