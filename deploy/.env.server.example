# 复制为 .env.server 后填写（此文件已被 .gitignore 排除，不会进仓库）
# ────────────────────────────────────────────────
# 知乎开放平台 Access Secret（developer.zhihu.com/profile 生成）
ZHIHU_ACCESS_SECRET=replace_me

# OpenAI 兼容网关（刘看山对话/居民评论/对局 Bot/直答共用；不填则诚实降级为演示回答）
ZHIHU_LLM_BASE_URL=
ZHIHU_LLM_API_KEY=
ZHIHU_LLM_MODEL=

# 知乎 OAuth（提交作品页「查看分配的三方应用」获取；回调地址 http://<服务器IP>/api/auth/zhihu/callback）
ZHIHU_OAUTH_APP_ID=
ZHIHU_OAUTH_APP_KEY=
