# 知乎开放平台 Access Secret（https://developer.zhihu.com/profile 生成）
# 只在服务端使用，严禁提交真实值
ZHIHU_ACCESS_SECRET=

# 知乎黑客松 OAuth（活动页创建项目后分配；回调地址登记为 {站点域名}/api/auth/zhihu/callback）
ZHIHU_OAUTH_APP_ID=
ZHIHU_OAUTH_APP_KEY=

# 可选：OpenAI 兼容网关（用于真 LLM 生成内容；不填则用内置 mock 生成器）
ZHIHU_LLM_BASE_URL=
ZHIHU_LLM_API_KEY=
ZHIHU_LLM_MODEL=

# 可选：CAMEL-AI OASIS 单一 sidecar 地址；未配置或健康检查失败时保留本地降级行为器
OASIS_ENGINE_URL=
