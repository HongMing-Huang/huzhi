# 知乎开放平台 Access Secret（https://developer.zhihu.com/profile 生成）
# 只在服务端使用，严禁提交真实值
ZHIHU_ACCESS_SECRET=

# 知乎黑客松 OAuth（活动页创建项目后分配；回调地址登记为 {站点域名}/api/auth/zhihu/callback）
ZHIHU_OAUTH_APP_ID=
ZHIHU_OAUTH_APP_KEY=

# 可选：OpenAI 兼容网关（用于真 LLM 生成内容；不填则用内置 mock 生成器）
ZHIHU_LLM_BASE_URL=
ZHIHU_LLM_API_KEY=
ZHIHU_LLM_MODEL=

# 可选：Upstash Redis（Vercel 等只读文件系统平台的持久化；不填则用本地 JSON 文件库）
# 从 Upstash 控制台 REST API 页复制；仅接受 *.upstash.io 域名
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 可选：CAMEL-AI OASIS sidecar 心跳令牌。sidecar 以 push 模型每 5s 主动
# POST /api/agents/runtime 上报状态（Web 端不对 sidecar 做出站探测）；
# 两边配置相同值时心跳必须携带 x-sidecar-token 头，不配则不校验。
OASIS_SIDECAR_TOKEN=
